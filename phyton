PBKDF2_ITERATIONS = 310_000
USERNAME_RE = re.compile(r"[A-Za-z0-9_.]{3,20}")
EMAIL_RE = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}")
_DUMMY_HASH = []


class ValidationError(ValueError):
    """A user-facing input problem (shown in the form, never a crash)."""


class DatabaseError(Exception):
    """The progress database could not be read or written."""


def hash_password(password, salt=None, iterations=PBKDF2_ITERATIONS):
    """Salted PBKDF2-SHA256. Only this hash is stored, never the password itself."""
    salt = salt or secrets.token_bytes(16)
    digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, iterations)
    return f"pbkdf2_sha256${iterations}${salt.hex()}${digest.hex()}"


def verify_password(password, stored):
    try:
        algorithm, iterations, salt_hex, digest_hex = stored.split("$")
        if algorithm != "pbkdf2_sha256":
            return False
        digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"),
                                     bytes.fromhex(salt_hex), int(iterations))
        return hmac.compare_digest(digest.hex(), digest_hex)
    except (ValueError, AttributeError):
        return False


def _dummy_verify(password):
    """Spend the same time on unknown usernames so logins don't reveal which accounts exist."""
    if not _DUMMY_HASH:
        _DUMMY_HASH.append(hash_password(secrets.token_hex(8)))
    verify_password(password, _DUMMY_HASH[0])


def clean_full_name(value):
    value = " ".join(value.split())
    if len(value) < 2:
        raise ValidationError("Full name must have at least 2 characters.")
    if len(value) > 60:
        raise ValidationError("Full name can be at most 60 characters.")
    return value


def clean_username(value):
    value = value.strip().lstrip("@")
    if not USERNAME_RE.fullmatch(value):
        raise ValidationError("Username must be 3-20 characters using letters, numbers, _ or . only.")
    return value


def clean_email(value):
    value = value.strip()
    if len(value) > 254 or not EMAIL_RE.fullmatch(value):
        raise ValidationError("Please enter a valid email address, like you@gmail.com.")
    return value


def clean_bio(value):
    value = value.strip()
    if len(value) > 160:
        raise ValidationError(f"Bio can be at most 160 characters (it has {len(value)}).")
    return value


def check_password_strength(password):
    if len(password) < 8:
        raise ValidationError("Password must be at least 8 characters.")
    if len(password) > 128:
        raise ValidationError("Password can be at most 128 characters.")
    if not re.search(r"[A-Za-z]", password) or not re.search(r"\d", password):
        raise ValidationError("Password must contain at least one letter and one number.")


def now_iso():
    return datetime.datetime.now().replace(microsecond=0).isoformat(sep=" ")


def format_date(value, with_time=False):
    try:
        moment = datetime.datetime.fromisoformat(value)
    except (TypeError, ValueError):
        return "—"
    return moment.strftime("%b %d, %Y · %I:%M %p" if with_time else "%B %d, %Y")


def initials(name):
    letters = "".join(word[0] for word in name.split()[:2] if word)
    return letters.upper() or "?"


def shorten(text, limit):
    return text if len(text) <= limit else text[:limit - 1] + "…"


