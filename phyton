    def _render_block(self, parent, block, first=False):
        kind = block["type"]
        if kind == "h":
            self._text(parent, block["text"], 17, "bold", inset=210).pack(
                anchor="w", fill="x", pady=(0 if first else 20, 6))
        elif kind == "p":
            self._text(parent, block["text"], 14, color=C["text_soft"], inset=210).pack(
                anchor="w", fill="x", pady=(0, 4))
        elif kind == "bullets":
            for item in block["items"]:
                row = ctk.CTkFrame(parent, fg_color="transparent")
                row.pack(fill="x", pady=2)
                ctk.CTkLabel(row, text="•", width=18, font=self.font(16, "bold"),
                             text_color=C["accent"]).pack(side="left", anchor="n")
                self._text(row, item, 14, color=C["text_soft"], inset=240).pack(side="left", fill="x")
        elif kind == "code":
            self._code_block(parent, block)
        elif kind == "table":
            self._table(parent, block)
        elif kind == "try":
            self._try_it_block(parent)

    def _code_block(self, parent, block):
        tone = {"good": C["success"], "bad": C["error"]}.get(block.get("tone"))
        box = ctk.CTkFrame(parent, fg_color=C["code_bg"], corner_radius=12, border_width=1,
                           border_color=tone or C["border"])
        box.pack(fill="x", pady=8)
        if block.get("label"):
            ctk.CTkLabel(box, text=block["label"], font=self.font(10, "bold"), height=14,
                         text_color=tone or C["muted"], anchor="w").pack(anchor="w", padx=18, pady=(12, 0))
        ctk.CTkLabel(box, text=block["code"], font=self.font(13, kind="mono"), text_color=C["text"],
                     justify="left", anchor="w").pack(anchor="w", fill="x", padx=18,
                                                      pady=(6 if block.get("label") else 12, 12))
        if block.get("output") is not None:
            ctk.CTkFrame(box, fg_color=C["border"], height=1).pack(fill="x", padx=1)
            ctk.CTkLabel(box, text="OUTPUT", font=self.font(10, "bold"), text_color=C["muted"],
                         height=14, anchor="w").pack(anchor="w", padx=18, pady=(10, 0))
            ctk.CTkLabel(box, text=block["output"], font=self.font(13, kind="mono"),
                         text_color=C["error"] if block.get("tone") == "bad" else C["output"],
                         justify="left", anchor="w").pack(anchor="w", fill="x", padx=18, pady=(4, 12))

    def _table(self, parent, block):
        box = ctk.CTkFrame(parent, fg_color=C["code_bg"], corner_radius=12, border_width=1,
                           border_color=C["border"])
        box.pack(fill="x", pady=8)
        grid = ctk.CTkFrame(box, fg_color="transparent")
        grid.pack(fill="x", padx=8, pady=8)
        mono_columns = block.get("mono", set())
        for column, header in enumerate(block["headers"]):
            grid.grid_columnconfigure(column, weight=1)
            ctk.CTkLabel(grid, text=header.upper(), font=self.font(10, "bold"), text_color=C["muted"],
                         anchor="w").grid(row=0, column=column, sticky="ew", padx=10, pady=(2, 4))
        for row_number, row in enumerate(block["rows"], start=1):
            stripe = C["surface"] if row_number % 2 else "transparent"
            for column, value in enumerate(row):
                is_mono = column in mono_columns
                ctk.CTkLabel(grid, text=value, fg_color=stripe, corner_radius=0, anchor="w",
                             font=self.font(13, kind="mono" if is_mono else "ui"),
                             text_color=C["primary_text"] if is_mono and column == 0 else C["text_soft"]
                             ).grid(row=row_number, column=column, sticky="nsew", ipadx=10, ipady=3)

    def _try_it_block(self, parent):
        box = ctk.CTkFrame(parent, fg_color=C["primary_soft"], corner_radius=14, border_width=1,
                           border_color=C["primary"])
        box.pack(fill="x", pady=(14, 4))
        inner = ctk.CTkFrame(box, fg_color="transparent")
        inner.pack(fill="x", padx=20, pady=16)
        ctk.CTkLabel(inner, text="TRY THE FIRST LINE YOURSELF", font=self.font(10, "bold"),
                     text_color=C["primary_text"], height=14, anchor="w").pack(anchor="w")
        ctk.CTkLabel(inner, text='name = input("Enter your name: ")', font=self.font(13, kind="mono"),
                     text_color=C["text"], anchor="w").pack(anchor="w", pady=(6, 10))
        row = ctk.CTkFrame(inner, fg_color="transparent")
        row.pack(fill="x")
        entry = self._entry(row, "Enter your name:", width=300)
        entry.pack(side="left")
        output = ctk.CTkLabel(inner, text="", font=self.font(14, "bold", "mono"),
                              text_color=C["output"], anchor="w", height=0)

        def run():
            output.configure(text=f"Student: {entry.get()}", height=28)
            if not output.winfo_ismapped():
                output.pack(anchor="w", pady=(10, 0))

        self._button(row, "Run", run, width=90, height=44).pack(side="left", padx=10)
        entry.bind("<Return>", lambda _e: run())

