    def refresh_chrome(self):
        for key, button in self.nav_buttons.items():
            text, color = self._nav_label(key)
            active = key == self.current_key
            button.configure(text=text, text_color=C["text"] if active else color,
                             fg_color=C["card"] if active else "transparent",
                             font=self.font(13, "bold" if active else "normal"))
        self.rank_label.configure(text=self.quest.rank)
        self.progress_label.configure(text=f"PROGRESS  ·  {self.quest.passed} / {TOTAL_LESSONS} COMPLETED")
        self._animate_progress(self.quest.passed / TOTAL_LESSONS)

    def _animate_progress(self, target, step=0, start=None):
        self._animate_bar(self.progress, target, step, start)

    def _animate_bar(self, bar, target, step=0, start=None):
        try:
            if start is None:
                start = bar.get()
            steps = 18
            eased = 1 - (1 - step / steps) ** 3
            bar.set(start + (target - start) * eased)
        except tk.TclError:
            return
        if step < steps:
            self.after(16, lambda: self._animate_bar(bar, target, step + 1, start))

    def _progress_overview(self, parent, title="Overall progress"):
        """Card with the overall progress bar and Completed / In progress / Not started legend."""
        completed, in_progress, not_started = self.quest.counts()
        percent = round(completed / TOTAL_LESSONS * 100)
        card = self._card(parent, radius=16)
        inner = ctk.CTkFrame(card, fg_color="transparent")
        inner.pack(fill="x", padx=22, pady=18)
        top = ctk.CTkFrame(inner, fg_color="transparent")
        top.pack(fill="x")
        ctk.CTkLabel(top, text=title, font=self.font(15, "bold"), text_color=C["text"],
                     anchor="w").pack(side="left")
        ctk.CTkLabel(top, text=f"{percent}%", font=self.font(20, "bold"), text_color=C["success"],
                     anchor="e").pack(side="right")
        bar = ctk.CTkProgressBar(inner, height=12, corner_radius=6, fg_color=C["border"],
                                 progress_color=C["success"])
        bar.set(0)
        bar.pack(fill="x", pady=(10, 12))
        self.after(120, lambda: self._animate_bar(bar, completed / TOTAL_LESSONS))
        legend = ctk.CTkFrame(inner, fg_color="transparent")
        legend.pack(fill="x")
        for text, color in ((f"{completed} Completed", C["success"]),
                            (f"{in_progress} In progress", C["primary_text"]),
                            (f"{not_started} Not started", C["muted"])):
            item = ctk.CTkFrame(legend, fg_color="transparent")
            item.pack(side="left", padx=(0, 22))
            ctk.CTkLabel(item, text="", width=10, height=10, corner_radius=5,
                         fg_color=color).pack(side="left")
            ctk.CTkLabel(item, text=text, font=self.font(12, "bold"), text_color=C["text_soft"],
                         height=18).pack(side="left", padx=(7, 0))
        return card

    def _show_page(self, key, title, subtitle, builder):
        self.current_key = key
        self.page_title.configure(text=title)
        self.page_subtitle.configure(text=subtitle)
        if self.scroll is not None:
            self.scroll.destroy()
        self._wrap_targets = []
        self.scroll = ctk.CTkScrollableFrame(self.body, fg_color=C["bg"], corner_radius=0,
                                             scrollbar_button_color=C["border"],
                                             scrollbar_button_hover_color=C["muted"])
        self.scroll.pack(fill="both", expand=True)
        page = ctk.CTkFrame(self.scroll, fg_color="transparent")
        page.pack(fill="x", padx=(28, 16), pady=(6, 36))
        builder(page)
        self.refresh_chrome()
        self.after(20, lambda: self._update_wrap(self.body.winfo_width()))

