    def _set_form_busy(self, busy, text=None):
        self.start_button.configure(state="disabled" if busy else "normal",
                                    text=text or ("Sign In" if self.auth_mode == "signin" else "Create Account"))

    def _on_auth_submit(self):
        if str(self.start_button.cget("state")) == "disabled":
            return
        if self.auth_mode == "signin":
            self._on_sign_in()
        else:
            self._on_register()

    def _on_sign_in(self):
        login = self.login_entry.get().strip().lstrip("@")
        password = self.password_entry.get()
        if not login or not password:
            self._set_form_status("Enter your username (or email) and your password.")
            return
        self._set_form_busy(True, "Signing in...")
        self.update_idletasks()
        try:
            user_id = self.db.authenticate(login, password)
        except DatabaseError as exc:
            self._set_form_busy(False)
            self._set_form_status(f"Could not read your account: {exc}")
            return
        self._set_form_busy(False)
        if user_id is None:
            self._set_form_status("Incorrect username/email or password. Try again.")
            self.password_entry.delete(0, "end")
            self.password_entry.focus_set()
            return
        self._begin(user_id)

    def _on_register(self):
        try:
            full_name = clean_full_name(self.fullname_entry.get())
            username = clean_username(self.username_entry.get())
            email = clean_email(self.email_entry.get())
            password = self.password_entry.get()
            check_password_strength(password)
            if password != self.confirm_entry.get():
                raise ValidationError("The two passwords do not match.")
        except ValidationError as exc:
            self._set_form_status(str(exc))
            return
        self._set_form_busy(True, "Creating your account...")
        self.update_idletasks()
        try:
            user_id = self.db.create_user(full_name, username, email, password)
        except ValidationError as exc:
            self._set_form_busy(False)
            self._set_form_status(str(exc))
            return
        except DatabaseError as exc:
            self._set_form_busy(False)
            self._set_form_status(f"Could not create the account: {exc}")
            return
        self._set_form_busy(False)
        self._begin(user_id, new_account=True)

    def _begin(self, user_id, new_account=False):
        quest = QuestState()
        try:
            quest.load_account(self.db, user_id)
        except DatabaseError as exc:
            self._set_form_status(f"Could not load your saved progress: {exc}")
            return
        self.quest = quest
        self._pdf_cache = None
        self.current_key = None
        self._sync_state(silent=True)
        self.build_shell()
        self.show_dashboard()
        if new_account:
            self.toast(f"Welcome, {quest.player}! Your account is ready. Progress saves automatically.",
                       "success")
            self.toast("Choose any lesson you like.", "info")
        else:
            completed, in_progress, _ = quest.counts()
            self.toast(f"Welcome back, {quest.player}! Progress restored: {completed}/{TOTAL_LESSONS} "
                       f"completed, {in_progress} in progress.", "success")

    # ---------------------------------------------------------------
    #  Automatic saving (called from the lesson, quiz and certificate flows)
    # ---------------------------------------------------------------

    def _save(self, action, *args, silent=False, **kwargs):
        """Run one database write for the signed-in user. On failure warn instead of crashing."""
        if self.quest.user_id is None:
            return False
        try:
            action(self.quest.user_id, *args, **kwargs)
            return True
        except DatabaseError as exc:
            if not silent:
                self.toast(f"Could not save your progress: {exc}", "error", 7000)
            return False

    def _award(self, code, silent=False):
        if self.quest.user_id is None or code in self.quest.achievements:
            return
        try:
            newly = self.db.grant_achievement(self.quest.user_id, code)
        except DatabaseError as exc:
            self.toast(f"Could not save the achievement: {exc}", "error", 6000)
            return
        self.quest.achievements[code] = now_iso()
        if newly and not silent:
            title, desc, _icon = ACHIEVEMENT_INFO[code]
            self.toast(f"Achievement unlocked: {title}. {desc}.", "success")

    def _autosave_lesson_opened(self, index):
        quest = self.quest
        if self._save(self.db.mark_lesson_opened, index):
            if quest.status(index) == "not_started":
                quest.lesson_status[index] = "in_progress"
            quest.current_lesson = index
            self._award("first_steps")

    def _autosave_quiz(self, index, score, total):
        quest = self.quest
        if not self._save(self.db.record_quiz, index, score, total):
            return
        try:
            quest.reload_progress(self.db)
        except DatabaseError:
            pass
        self._award("first_quiz")
        if score == total:
            self._award(f"lesson-{index}", silent=True)
        self._sync_state()

    def _sync_state(self, silent=False):
        """Save rank, certificate eligibility and delivery info, and grant earned milestones."""
        quest = self.quest
        if quest.user_id is None:
            return
        eligible = quest.passed == TOTAL_LESSONS
        fields = dict(rank=quest.rank, certificate_eligible=int(eligible), cert_sent=int(quest.cert_sent),
                      pdf_saved=int(quest.pdf_saved), current_lesson=quest.current_lesson)
        if eligible and not quest.certificate_unlocked_at:
            quest.certificate_unlocked_at = now_iso()
            fields["certificate_unlocked_at"] = quest.certificate_unlocked_at
        if quest.cert_sent and "certificate_sent" not in quest.achievements:
            fields["cert_sent_at"] = now_iso()
        self._save(self.db.update_state, silent=silent, **fields)
        for index in sorted(quest.passed_lessons):
            self._award(f"lesson-{index}", silent=True)
        if quest.passed >= 4:
            self._award("rank_coder", silent=True)
        if eligible:
            self._award("rank_master", silent=True)
            self._award("certificate_unlocked", silent=silent)
        if quest.cert_sent:
            self._award("certificate_sent", silent=silent)

