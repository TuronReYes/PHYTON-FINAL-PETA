    def _lesson_card(self, parent, index, lesson):
        status = self.quest.status(index)
        passed = status == "completed"
        border = {"completed": C["success"], "in_progress": C["primary"]}.get(status)
        icon_bg, icon_fg = {"completed": (C["success_soft"], C["success"]),
                            "in_progress": (C["primary_soft"], C["primary_text"])}.get(
            status, (C["border"], C["muted"]))
        card = self._card(parent, border=border)
        inner = ctk.CTkFrame(card, fg_color="transparent")
        inner.pack(fill="both", expand=True, padx=20, pady=18)

        top = ctk.CTkFrame(inner, fg_color="transparent")
        top.pack(fill="x")
        ctk.CTkLabel(top, text="✓" if passed else str(index + 1), width=38, height=38, corner_radius=10,
                     fg_color=icon_bg, text_color=icon_fg, font=self.font(15, "bold")).pack(side="left")
        self._status_pill(top, index).pack(side="right")

        ctk.CTkLabel(inner, text=lesson["title"], font=self.font(16, "bold"), text_color=C["text"],
                     anchor="w").pack(anchor="w", fill="x", pady=(12, 0))
        self._text(inner, lesson["summary"], 13, color=C["muted"], inset=190, columns=2).pack(
            anchor="w", fill="x", pady=(2, 12))

        bottom = ctk.CTkFrame(inner, fg_color="transparent")
        bottom.pack(fill="x", side="bottom")
        row = self.quest.progress_rows.get(index)
        meta = f"{len(lesson['quiz'])} quiz questions"
        if row and row["attempts"]:
            meta += f"  ·  best {row['best_score']}/{row['total_questions']}"
