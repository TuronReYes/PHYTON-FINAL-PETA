class QuestState:
    def __init__(self):
        self.player = ""
        self.email = ""
        self.cert_sent = False
        self.pdf_generated = False
        self.pdf_saved = False
        self.last_error = None
        self.passed_lessons = set()
        # Account data (filled from the database when a user signs in)
        self.user_id = None
        self.username = ""
        self.bio = ""
        self.avatar_path = None
        self.created_at = None
        self.last_login = None
        self.lesson_status = {}          # lesson index -> "in_progress" / "completed"
        self.progress_rows = {}          # lesson index -> saved row (scores, attempts, dates)
        self.current_lesson = None
        self.certificate_unlocked_at = None
        self.achievements = {}           # code -> earned_at

    def load_account(self, db, user_id):
        """Restore everything saved for this one account."""
        account = db.get_account(user_id)
        if account is None:
            raise DatabaseError("That account no longer exists.")
        state = db.get_state(user_id)
        self.user_id = user_id
        self.apply_account(account)
        self.reload_progress(db)
        current = state["current_lesson"]
        self.current_lesson = current if current is not None and 0 <= current < TOTAL_LESSONS else None
        self.cert_sent = bool(state["cert_sent"])
        self.pdf_saved = bool(state["pdf_saved"])
        self.certificate_unlocked_at = state["certificate_unlocked_at"]
        self.achievements = db.achievements(user_id)

    def apply_account(self, account):
        self.player = account["full_name"]
        self.username = account["username"]
        self.email = account["email"]
        self.bio = account["bio"] or ""
        self.avatar_path = account["avatar_path"]
        self.created_at = account["created_at"]
        self.last_login = account["last_login"]

    def reload_progress(self, db):
        self.progress_rows = {i: row for i, row in db.load_progress(self.user_id).items()
                              if 0 <= i < TOTAL_LESSONS}
        self.lesson_status = {i: row["status"] for i, row in self.progress_rows.items()
                              if row["status"] != "not_started"}
        self.passed_lessons = {i for i, status in self.lesson_status.items() if status == "completed"}

    def status(self, index):
        if index in self.passed_lessons:
            return "completed"
        return self.lesson_status.get(index, "not_started")

    def counts(self):
        in_progress = sum(1 for i in range(TOTAL_LESSONS) if self.status(i) == "in_progress")
        return self.passed, in_progress, TOTAL_LESSONS - self.passed - in_progress

    def best_points(self):
        return sum(row["best_score"] for row in self.progress_rows.values())

    @property
    def passed(self):
        return len(self.passed_lessons)

    @property
    def rank(self):
        if self.passed == 7:
            return "Python Master"
        elif self.passed >= 4:
            return "Coder"
        return "Newbie"

    def is_passed(self, index):
        return index in self.passed_lessons

    def mark_passed(self, index):
        newly_passed = index not in self.passed_lessons
        self.passed_lessons.add(index)
        self.lesson_status[index] = "completed"
        return newly_passed

    def next_unpassed(self, start=0):
        for offset in range(TOTAL_LESSONS):
            index = (start + offset) % TOTAL_LESSONS
            if index not in self.passed_lessons:
                return index
        return None


