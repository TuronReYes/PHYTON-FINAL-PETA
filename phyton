def _db_guard(method):
    """Turn low-level sqlite3 errors into a friendly DatabaseError."""
    @functools.wraps(method)
    def wrapper(self, *args, **kwargs):
        try:
            return method(self, *args, **kwargs)
        except sqlite3.Error as exc:
            raise DatabaseError(str(exc)) from exc
    return wrapper


class Database:

    def __init__(self, path=DB_FILE):
        self.path = Path(path)
        self.root = self.path.parent
        self.avatar_dir = self.root / "avatars"
        try:
            self.root.mkdir(parents=True, exist_ok=True)
            self.avatar_dir.mkdir(parents=True, exist_ok=True)
            self.conn = sqlite3.connect(str(self.path), timeout=10)
            self.conn.row_factory = sqlite3.Row
            self.conn.execute("PRAGMA foreign_keys = ON")
            self.conn.execute("PRAGMA journal_mode = WAL")
            self.conn.executescript(SCHEMA)
            self.conn.execute(f"PRAGMA user_version = {SCHEMA_VERSION}")
            self.conn.commit()
        except (sqlite3.Error, OSError) as exc:
            raise DatabaseError(f"Could not open the database at {self.path} ({exc})") from exc
        try:
            os.chmod(self.path, 0o600)
        except OSError:
            pass

    def close(self):
        try:
            self.conn.close()
        except sqlite3.Error:
            pass

    # ---------------- accounts ----------------

    @_db_guard
    def username_taken(self, username, exclude_id=None):
        row = self.conn.execute("SELECT 1 FROM users WHERE username = ? AND id != ?",
                                (username, exclude_id or -1)).fetchone()
        return row is not None

    @_db_guard
    def email_taken(self, email, exclude_id=None):
        row = self.conn.execute("SELECT 1 FROM users WHERE email = ? AND id != ?",
                                (email, exclude_id or -1)).fetchone()
        return row is not None

    @_db_guard
    def create_user(self, full_name, username, email, password):
        if self.username_taken(username):
            raise ValidationError("That username is already taken. Please choose another.")
        if self.email_taken(email):
            raise ValidationError("An account with that email already exists. Try signing in.")
        stamp = now_iso()
        try:
            with self.conn:
                cursor = self.conn.execute(
                    "INSERT INTO users (username, email, password_hash, created_at, last_login) "
                    "VALUES (?, ?, ?, ?, ?)", (username, email, hash_password(password), stamp, stamp))
                user_id = cursor.lastrowid
                self.conn.execute("INSERT INTO profiles (user_id, full_name, bio, updated_at) "
                                  "VALUES (?, ?, '', ?)", (user_id, full_name, stamp))
                self.conn.execute("INSERT INTO user_state (user_id) VALUES (?)", (user_id,))
        except sqlite3.IntegrityError as exc:
            raise ValidationError("That username or email is already registered.") from exc
        return user_id

    @_db_guard
    def authenticate(self, login, password):
        """Return the user id for a username-or-email + password, or None."""
        row = self.conn.execute("SELECT id, password_hash FROM users WHERE username = ? OR email = ?",
                                (login, login)).fetchone()
        if row is None:
            _dummy_verify(password)
            return None
        if not verify_password(password, row["password_hash"]):
            return None
        with self.conn:
            self.conn.execute("UPDATE users SET last_login = ? WHERE id = ?", (now_iso(), row["id"]))
        return row["id"]

    @_db_guard
    def get_account(self, user_id):
        row = self.conn.execute(
            "SELECT u.id, u.username, u.email, u.created_at, u.last_login, p.full_name, p.bio, "
            "pp.file_path AS avatar_file FROM users u JOIN profiles p ON p.user_id = u.id "
            "LEFT JOIN profile_pictures pp ON pp.user_id = u.id WHERE u.id = ?", (user_id,)).fetchone()
        if row is None:
            return None
        account = dict(row)
        avatar_file = account.pop("avatar_file")
        avatar = self.root / avatar_file if avatar_file else None
        account["avatar_path"] = str(avatar) if avatar and avatar.is_file() else None
        return account

    @_db_guard
    def update_profile(self, user_id, full_name, username, email, bio):
        if self.username_taken(username, exclude_id=user_id):
            raise ValidationError("That username is already taken. Please choose another.")
        if self.email_taken(email, exclude_id=user_id):
            raise ValidationError("Another account already uses that email address.")
        try:
            with self.conn:
                self.conn.execute("UPDATE users SET username = ?, email = ? WHERE id = ?",
                                  (username, email, user_id))
                self.conn.execute("UPDATE profiles SET full_name = ?, bio = ?, updated_at = ? "
                                  "WHERE user_id = ?", (full_name, bio, now_iso(), user_id))
        except sqlite3.IntegrityError as exc:
            raise ValidationError("That username or email is already registered.") from exc

    @_db_guard
    def change_password(self, user_id, current, new):
        row = self.conn.execute("SELECT password_hash FROM users WHERE id = ?", (user_id,)).fetchone()
        if row is None or not verify_password(current, row["password_hash"]):
            return False
        with self.conn:
            self.conn.execute("UPDATE users SET password_hash = ? WHERE id = ?",
                              (hash_password(new), user_id))
        return True

    @_db_guard
    def delete_user(self, user_id, password):
        """Delete the account and ALL of its data (cascades) after re-checking the password."""
        row = self.conn.execute("SELECT password_hash FROM users WHERE id = ?", (user_id,)).fetchone()
        if row is None or not verify_password(password, row["password_hash"]):
            return False
        with self.conn:
            self.conn.execute("DELETE FROM users WHERE id = ?", (user_id,))
        shutil.rmtree(self.avatar_dir / f"user_{int(user_id)}", ignore_errors=True)
        return True

    # ---------------- profile pictures ----------------

    def _remove_avatar_file(self, relative):
        if not relative:
            return
        target = (self.root / relative).resolve()
        if self.avatar_dir.resolve() in target.parents:
            try:
                target.unlink()
            except OSError:
                pass

    @_db_guard
    def set_avatar(self, user_id, image, original_name=None):
        """Save a processed PIL image as the user's picture and record its path."""
        folder = self.avatar_dir / f"user_{int(user_id)}"
        filename = f"avatar_{datetime.datetime.now():%Y%m%d%H%M%S}_{secrets.token_hex(3)}.png"
        try:
            folder.mkdir(parents=True, exist_ok=True)
            image.save(folder / filename, "PNG", optimize=True)
        except OSError as exc:
            raise DatabaseError(f"Could not save the picture file ({exc})") from exc
        relative = f"avatars/user_{int(user_id)}/{filename}"
        old = self.conn.execute("SELECT file_path FROM profile_pictures WHERE user_id = ?",
                                (user_id,)).fetchone()
        try:
            with self.conn:
                self.conn.execute(
                    "INSERT INTO profile_pictures (user_id, file_path, original_name, uploaded_at) "
                    "VALUES (?, ?, ?, ?) ON CONFLICT(user_id) DO UPDATE SET file_path = excluded.file_path, "
                    "original_name = excluded.original_name, uploaded_at = excluded.uploaded_at",
                    (user_id, relative, original_name, now_iso()))
        except sqlite3.Error:
            self._remove_avatar_file(relative)
            raise
        if old:
            self._remove_avatar_file(old["file_path"])
        return str(self.root / relative)

    @_db_guard
    def remove_avatar(self, user_id):
        old = self.conn.execute("SELECT file_path FROM profile_pictures WHERE user_id = ?",
                                (user_id,)).fetchone()
        with self.conn:
            self.conn.execute("DELETE FROM profile_pictures WHERE user_id = ?", (user_id,))
        if old:
            self._remove_avatar_file(old["file_path"])

    # ---------------- progress ----------------

    @_db_guard
    def load_progress(self, user_id):
        rows = self.conn.execute("SELECT * FROM lesson_progress WHERE user_id = ?", (user_id,)).fetchall()
        return {row["lesson_index"]: dict(row) for row in rows}

    @_db_guard
    def mark_lesson_opened(self, user_id, index):
        stamp = now_iso()
        with self.conn:
            self.conn.execute(
                "INSERT INTO lesson_progress (user_id, lesson_index, status, first_opened_at, last_opened_at) "
                "VALUES (?, ?, 'in_progress', ?, ?) ON CONFLICT(user_id, lesson_index) DO UPDATE SET "
                "last_opened_at = excluded.last_opened_at, "
                "first_opened_at = COALESCE(first_opened_at, excluded.first_opened_at), "
                "status = CASE WHEN status = 'not_started' THEN 'in_progress' ELSE status END",
                (user_id, index, stamp, stamp))
            self.conn.execute("INSERT OR IGNORE INTO user_state (user_id) VALUES (?)", (user_id,))
            self.conn.execute("UPDATE user_state SET current_lesson = ? WHERE user_id = ?", (index, user_id))

    @_db_guard
    def record_quiz(self, user_id, index, score, total):
        passed = int(score == total)
        stamp = now_iso()
        with self.conn:
            self.conn.execute("INSERT INTO quiz_results (user_id, lesson_index, score, total, passed, taken_at) "
                              "VALUES (?, ?, ?, ?, ?, ?)", (user_id, index, score, total, passed, stamp))
            self.conn.execute(
                "INSERT INTO lesson_progress (user_id, lesson_index, status, best_score, total_questions, "
                "attempts, first_opened_at, last_opened_at, completed_at) VALUES (?, ?, ?, ?, ?, 1, ?, ?, ?) "
                "ON CONFLICT(user_id, lesson_index) DO UPDATE SET "
                "best_score = MAX(best_score, excluded.best_score), "
                "total_questions = excluded.total_questions, attempts = attempts + 1, "
                "last_opened_at = excluded.last_opened_at, "
                "status = CASE WHEN status = 'completed' OR excluded.status = 'completed' "
                "THEN 'completed' ELSE 'in_progress' END, "
                "completed_at = COALESCE(completed_at, excluded.completed_at)",
                (user_id, index, "completed" if passed else "in_progress", score, total,
                 stamp, stamp, stamp if passed else None))

    @_db_guard
    def recent_quiz_results(self, user_id, limit=8):
        rows = self.conn.execute("SELECT * FROM quiz_results WHERE user_id = ? ORDER BY taken_at DESC, id DESC "
                                 "LIMIT ?", (user_id, limit)).fetchall()
        return [dict(row) for row in rows]

    @_db_guard
    def quiz_summary(self, user_id):
        row = self.conn.execute("SELECT COUNT(*) AS attempts, COALESCE(SUM(passed), 0) AS passed "
                                "FROM quiz_results WHERE user_id = ?", (user_id,)).fetchone()
        return dict(row)

    @_db_guard
    def grant_achievement(self, user_id, code):
        """Return True only the first time the achievement is earned."""
        with self.conn:
            cursor = self.conn.execute("INSERT OR IGNORE INTO achievements (user_id, code, earned_at) "
                                       "VALUES (?, ?, ?)", (user_id, code, now_iso()))
        return cursor.rowcount == 1

    @_db_guard
    def achievements(self, user_id):
        rows = self.conn.execute("SELECT code, earned_at FROM achievements WHERE user_id = ?",
                                 (user_id,)).fetchall()
        return {row["code"]: row["earned_at"] for row in rows}

    @_db_guard
    def get_state(self, user_id):
        with self.conn:
            self.conn.execute("INSERT OR IGNORE INTO user_state (user_id) VALUES (?)", (user_id,))
        return dict(self.conn.execute("SELECT * FROM user_state WHERE user_id = ?", (user_id,)).fetchone())

    @_db_guard
    def update_state(self, user_id, **fields):
        fields = {key: value for key, value in fields.items() if key in STATE_COLUMNS}
        if not fields:
            return
        assignments = ", ".join(f"{key} = ?" for key in fields)
        with self.conn:
            self.conn.execute("INSERT OR IGNORE INTO user_state (user_id) VALUES (?)", (user_id,))
            self.conn.execute(f"UPDATE user_state SET {assignments} WHERE user_id = ?",
                              (*fields.values(), user_id))


