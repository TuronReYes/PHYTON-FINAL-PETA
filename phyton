            username = clean_username(fields["username"].get())
            email = clean_email(fields["email"].get())
            bio = clean_bio(fields["bio"].get("1.0", "end"))
            self.db.update_profile(self.quest.user_id, full_name, username, email, bio)
        except ValidationError as exc:
            status.configure(text=str(exc), text_color=C["error"])
            return
        except DatabaseError as exc:
            status.configure(text=f"Could not save: {exc}", text_color=C["error"])
            return
        quest = self.quest
        if email.lower() != quest.email.lower():
            quest.last_error = None
        quest.player, quest.username, quest.email, quest.bio = full_name, username, email, bio
        self._pdf_cache = None
        self._rebuild_after_account_change("Profile saved.")

    def _change_password(self, entries, status):
        current, new, confirm = (entries[key].get() for key in ("current", "new", "confirm"))
        try:
            check_password_strength(new)
            if new != confirm:
                raise ValidationError("The new passwords do not match.")
            if new == current:
                raise ValidationError("The new password must be different from the current one.")
            changed = self.db.change_password(self.quest.user_id, current, new)
        except ValidationError as exc:
            status.configure(text=str(exc), text_color=C["error"])
            return
        except DatabaseError as exc:
            status.configure(text=f"Could not update the password: {exc}", text_color=C["error"])
            return
        if not changed:
            status.configure(text="Your current password is incorrect.", text_color=C["error"])
            return
        for entry in entries.values():
            entry.delete(0, "end")
        status.configure(text="✓ Password updated.", text_color=C["success"])
        self.toast("Password updated.", "success")

    def _delete_account(self, entry, status):
        password = entry.get()
        if not password:
            status.configure(text="Enter your password to confirm.")
            return
        if not messagebox.askyesno("Delete account",
                                   "This permanently deletes your account and ALL saved progress.\n\n"
                                   "Are you absolutely sure?", icon="warning"):
            return
        try:
            deleted = self.db.delete_user(self.quest.user_id, password)
        except DatabaseError as exc:
            status.configure(text=f"Could not delete the account: {exc}")
            return
        if not deleted:
            status.configure(text="That password is incorrect.")
            return
        self._end_session()
        self.toast("Your account and all of its data were deleted.", "info")

    def _rebuild_after_account_change(self, message):
        """Rebuild the shell so the sidebar card, avatars and names update everywhere."""
        key = self.current_key
        self.build_shell()
        {"profile": self.show_profile}.get(key, self.show_settings)()
        self.toast(message, "success")

    # ---------------------------------------------------------------
    #  Log out
    # ---------------------------------------------------------------

    def logout(self):
        if self.sending:
            if not messagebox.askyesno("Email still sending",
                                       "Your certificate is still being sent. Log out anyway?"):
                return
        elif not messagebox.askyesno("Log out", "Log out of Python Journey? Your progress is saved."):
            return
        self._sync_state(silent=True)
        name = self.quest.player
        self._end_session()
        self.toast(f"Logged out. See you soon, {name}!", "info")

    def _end_session(self):
        self.quest = QuestState()
        self._pdf_cache = None
        self._avatar_cache.clear()
        self.current_key = None
        self.cert_actions = None
        self.show_welcome()

    # ---------------------------------------------------------------
    #  Exit
    # ---------------------------------------------------------------

    def on_exit(self):
        if self.sending:
            if not messagebox.askyesno("Email still sending",
                                       "Your certificate is still being sent. Exit anyway?"):
                return
        elif not messagebox.askyesno("Exit Python Journey", "Are you sure you want to exit?"):
            return
        if self.quest.player:
            messagebox.showinfo("Goodbye",
                                f"Goodbye, {self.quest.player}! You passed {self.quest.passed} of 7 "
                                f"lessons. Rank: {self.quest.rank}\n\nYour progress is saved.")
        self._sync_state(silent=True)
        self.db.close()
        if self._temp_preview:
            try:
                os.remove(self._temp_preview)
            except OSError:
                pass
        self.destroy()


def main():
    app = PythonJourneyApp()
    app.mainloop()


if __name__ == "__main__":
    main()
