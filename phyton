AVATAR_SIZE = 512
AVATAR_TYPES = (".png", ".jpg", ".jpeg")
AVATAR_MAX_BYTES = 10 * 1024 * 1024


def load_avatar_source(path):
    """Open a user-chosen PNG/JPG/JPEG and return a square RGBA image ready to preview and save."""
    if not PIL_OK:
        raise ValidationError("Profile pictures need Pillow. Run:  pip install pillow")
    path = Path(path)
    if path.suffix.lower() not in AVATAR_TYPES:
        raise ValidationError("Please choose a PNG, JPG or JPEG image.")
    try:
        if path.stat().st_size > AVATAR_MAX_BYTES:
            raise ValidationError("That image is larger than 10 MB. Please choose a smaller one.")
        with Image.open(path) as source:
            if source.format not in ("PNG", "JPEG"):
                raise ValidationError("That file is not a real PNG or JPEG image.")
            image = ImageOps.exif_transpose(source).convert("RGBA")
    except ValidationError:
        raise
    except (OSError, ValueError, Image.DecompressionBombError) as exc:
        raise ValidationError(f"Could not open that image ({exc}).") from exc
    return ImageOps.fit(image, (AVATAR_SIZE, AVATAR_SIZE), Image.LANCZOS)


def circle_image(source, size, scale=3):
    """Crop an image into a smooth circle (drawn larger, then scaled down for anti-aliasing)."""
    big = size * scale
    image = ImageOps.fit(source.convert("RGBA"), (big, big), Image.LANCZOS)
    mask = Image.new("L", (big, big), 0)
    ImageDraw.Draw(mask).ellipse((0, 0, big - 1, big - 1), fill=255)
    result = Image.new("RGBA", (big, big), (0, 0, 0, 0))
    result.paste(image, (0, 0), mask)
    return result


