    def _text(self, parent, text, size=14, weight="normal", color=None, kind="ui",
              wrap=True, inset=150, columns=1, justify="left", anchor="w", **kwargs):
        label = ctk.CTkLabel(parent, text=text, font=self.font(size, weight, kind),
                             text_color=color or C["text"], justify=justify, anchor=anchor, **kwargs)
