def build_certificate_pdf(player, rank, passed, total, issued=None):
    """Return the certificate as PDF bytes (landscape A4). Every element is drawn from data."""
    if not REPORTLAB_OK:
        raise RuntimeError("ReportLab is not installed. Run:  pip install reportlab")

    cream, gold = HexColor(C["cert_bg"]), HexColor(C["cert_gold"])
    ink, name_color, soft, grey = (HexColor(C["cert_text"]), HexColor(C["cert_name"]),
                                   HexColor("#374151"), HexColor("#6B7280"))

    buffer = io.BytesIO()
    page_w, page_h = landscape(A4)
    pdf = pdf_canvas.Canvas(buffer, pagesize=(page_w, page_h))
    pdf.setTitle("Python Journey Certificate")
    pdf.setAuthor("Python Journey")
    pdf.setSubject("Certificate of Completion")

    # Cream paper
    pdf.setFillColor(cream)
    pdf.rect(0, 0, page_w, page_h, stroke=0, fill=1)

    # Gold double border
    pdf.setStrokeColor(gold)
    pdf.setLineWidth(3.5)
    pdf.rect(22, 22, page_w - 44, page_h - 44, stroke=1, fill=0)
    pdf.setLineWidth(1)
    pdf.rect(32, 32, page_w - 64, page_h - 64, stroke=1, fill=0)

    # Small gold corner squares
    pdf.setFillColor(gold)
    for cx in (22, page_w - 22):
        for cy in (22, page_h - 22):
            pdf.rect(cx - 4, cy - 4, 8, 8, stroke=0, fill=1)

    centre = page_w / 2
    top = page_h

    pdf.setFillColor(gold)
    pdf.setFont("Helvetica-Bold", 10)
    pdf.drawCentredString(centre, top - 74, "ACT102   ·   PYTHON QUEST")

    pdf.setFillColor(ink)
    pdf.setFont("Times-Bold", 32)
    pdf.drawCentredString(centre, top - 112, "CERTIFICATE OF COMPLETION")

    pdf.setFillColor(grey)
    pdf.setFont("Times-Italic", 14)
    pdf.drawCentredString(centre, top - 140, "Proudly presented to")

    # Recipient name, shrunk if very long so it always fits
    size = 36
    while size > 16 and stringWidth(player, "Times-Bold", size) > page_w - 160:
        size -= 1
    pdf.setFillColor(name_color)
    pdf.setFont("Times-Bold", size)
    pdf.drawCentredString(centre, top - 184, player)

    pdf.setStrokeColor(gold)
    pdf.setLineWidth(1.5)
    pdf.line(centre - 120, top - 198, centre + 120, top - 198)

    # Body paragraphs
    style = ParagraphStyle("body", fontName="Times-Roman", fontSize=11.5, leading=16,
                           textColor=soft, alignment=TA_CENTER)
    body_w = page_w - 190
    y = top - 220
    for text in certificate_paragraphs(player):
        paragraph = Paragraph(xml_escape(text), style)
        _, height = paragraph.wrapOn(pdf, body_w, page_h)
        y -= height
        paragraph.drawOn(pdf, (page_w - body_w) / 2, y)
        y -= 11

    # Footer: rank / lessons / issued
    details = certificate_details(rank, passed, total, issued)
    column_w = (page_w - 190) / 3
    for i, (caption, value) in enumerate(details):
        x = (page_w - body_w) / 2 + column_w * i + column_w / 2
        pdf.setFillColor(gold)
        pdf.setFont("Helvetica-Bold", 9)
        pdf.drawCentredString(x, 92, caption)
        pdf.setFillColor(ink)
        pdf.setFont("Times-Bold", 14)
        pdf.drawCentredString(x, 74, value)

    pdf.showPage()
    pdf.save()
    return buffer.getvalue()


