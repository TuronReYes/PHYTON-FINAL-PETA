def gmail_login(address, password):
    """Connect to the configured sender Gmail using an App Password and STARTTLS."""
    try:
        server = smtplib.SMTP("smtp.gmail.com", 587, timeout=25)
        server.ehlo()
        server.starttls()
        server.ehlo()
        server.login(address, password)
        return server
    except smtplib.SMTPAuthenticationError:
        try:
            server.quit()
        except Exception:
            pass
        return "wrong"
    except (OSError, smtplib.SMTPException):
        try:
            server.quit()
        except Exception:
            pass
        return "offline"


def get_gmail_sender_config():
    """Read the app-wide sender credentials from environment variables."""
    address = os.environ.get(GMAIL_SENDER_ENV, "").strip()
    app_password = os.environ.get(GMAIL_APP_PASSWORD_ENV, "").replace(" ", "").strip()
    return address, app_password


def build_certificate_email(sender, recipient, name, pdf_bytes, filename):
    """Build the certificate email and attach the generated PDF."""
    mail = EmailMessage()
    mail["Subject"] = "Your Python Quest Certificate"
    mail["From"] = sender
    mail["To"] = recipient
    mail.set_content(certificate_email_body(name))
    mail.add_attachment(pdf_bytes, maintype="application", subtype="pdf", filename=filename)
    return mail


def send_certificate(sender_address, app_password, recipient, name, pdf_bytes, filename):
    """Send a learner's certificate from the centrally configured Gmail sender."""
    if not sender_address or not app_password:
        return False, (
            "Gmail sender is not configured. Set PYTHON_JOURNEY_GMAIL_ADDRESS and "
            "PYTHON_JOURNEY_GMAIL_APP_PASSWORD in your Windows environment variables."
        )
    server = gmail_login(sender_address, app_password)
    if server == "wrong":
        return False, "Gmail authentication failed. Check the sender address and App Password."
    if server == "offline":
        return False, "Could not connect to Gmail. Check your internet connection."
    mail = build_certificate_email(sender_address, recipient, name, pdf_bytes, filename)
    try:
        refused = server.send_message(mail)
        if refused:
            return False, f"Gmail refused one or more recipients: {', '.join(refused.keys())}"
    except Exception as exc:
        return False, f"Gmail did not accept the message ({type(exc).__name__}: {exc})."
    finally:
        try:
            server.quit()
        except Exception:
            pass
    return True, f"Certificate PDF accepted by Gmail for {recipient}."


