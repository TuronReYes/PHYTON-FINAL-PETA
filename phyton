    def _preview_certificate(self):
        """Open the real PDF in the system viewer so the user sees exactly what will be saved/sent."""
        try:
            data = self.get_pdf()
            if self._temp_preview is None:
                handle = tempfile.NamedTemporaryFile(prefix="python_journey_preview_", suffix=".pdf",
                                                     delete=False)
                handle.close()
                self._temp_preview = handle.name
            with open(self._temp_preview, "wb") as out:
                out.write(data)
            webbrowser.open(Path(self._temp_preview).as_uri())
            self.toast("Opening the certificate PDF preview...", "info")
        except Exception as exc:
            self.quest.pdf_generated = False
            self.toast(f"Could not create the preview: {exc}", "error", 6000)
        self._render_cert_actions()

    def _save_pdf(self):
        quest = self.quest
        try:
            data = self.get_pdf()
        except Exception as exc:
            self.toast(f"Could not generate the PDF: {exc}", "error", 6000)
            self._render_cert_actions(pdf_error=str(exc))
            return
        path = filedialog.asksaveasfilename(
            title="Save certificate as PDF", defaultextension=".pdf",
            initialfile=certificate_filename(quest.player),
            filetypes=[("PDF document", "*.pdf"), ("All files", "*.*")])
        if not path:
            return
        try:
            with open(path, "wb") as handle:
                handle.write(data)
        except OSError as exc:
            self.toast(f"Could not save the PDF: {exc}", "error", 6000)
            messagebox.showerror("Could not save", f"The PDF could not be saved:\n{exc}")
            return
        quest.pdf_saved = True
        self._sync_state(silent=True)
        self.toast(f"PDF saved: {Path(path).name}", "success")
        self._render_cert_actions()

    def _copy_certificate(self):
        self.clipboard_clear()
        self.clipboard_append(certificate_text(self.quest.player))
        self.toast("Certificate text copied to the clipboard.", "success")

    def _save_certificate(self):
        safe_name = "".join(ch for ch in self.quest.player if ch.isalnum() or ch in " _-").strip() or "player"
        path = filedialog.asksaveasfilename(
            title="Save certificate", defaultextension=".txt",
            initialfile=f"{safe_name.replace(' ', '_')}_Python_Certificate.txt",
            filetypes=[("Text file", "*.txt"), ("All files", "*.*")])
        if not path:
            return
        try:
            with open(path, "w", encoding="utf-8") as handle:
                handle.write(certificate_text(self.quest.player))
        except OSError as exc:
            messagebox.showerror("Could not save", f"The certificate could not be saved:\n{exc}")
            return
        self.toast("Certificate saved.", "success")

