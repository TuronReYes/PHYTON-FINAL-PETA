        return ctk.CTkLabel(parent, text="Py", width=size, height=size, corner_radius=size // 4,
                            fg_color=C["accent"], text_color="#0B1220",
                            font=self.font(int(size * 0.4), "bold"))

    def _on_body_resize(self, event):
        if self._wrap_job is not None:
            self.after_cancel(self._wrap_job)
        self._wrap_job = self.after(60, lambda: self._update_wrap(event.width))

    def _update_wrap(self, width):
        self._wrap_job = None
        if width <= 1:
            return
        logical_width = width / self._scaling()
        alive = []
        for label, inset, columns in self._wrap_targets:
            try:
                label.configure(wraplength=max(240, (logical_width - inset) / columns))
                alive.append((label, inset, columns))
            except tk.TclError:
                continue
        self._wrap_targets = alive

