    #  Avatars (circular profile pictures)
    # ---------------------------------------------------------------

    def _ctk_circle(self, pil_image, size):
        return ctk.CTkImage(light_image=circle_image(pil_image, size), dark_image=circle_image(pil_image, size),
                            size=(size, size))

    def _avatar_image(self, path, size):
        if not PIL_OK or not path or not os.path.isfile(path):
            return None
        try:
            key = (path, size, os.path.getmtime(path))
            if key not in self._avatar_cache:
                with Image.open(path) as source:
                    source.load()
                    self._avatar_cache[key] = self._ctk_circle(source, size)
            return self._avatar_cache[key]
        except (OSError, ValueError):
            return None

    def _avatar(self, parent, size, ring=False, path="current", image=None, name=None):
        """Circular avatar: the user's picture, or their initials when no picture is set."""
        if path == "current":
            path = self.quest.avatar_path
        name = self.quest.player if name is None else name
        pad = 4 if ring else 0
        outer = size + pad * 2
        holder = ctk.CTkFrame(parent, width=outer, height=outer, corner_radius=outer // 2,
                              fg_color="transparent", border_width=2 if ring else 0,
                              border_color=C["accent"])
        holder.pack_propagate(False)
        holder.grid_propagate(False)
        picture = self._ctk_circle(image, size) if image is not None else self._avatar_image(path, size)
        if picture is not None:
            label = ctk.CTkLabel(holder, text="", image=picture, width=size, height=size)
            label._keep_image = picture
        else:
            label = ctk.CTkLabel(holder, text=initials(name or "?"), width=size, height=size,
                                 corner_radius=size // 2, fg_color=C["primary"], text_color="#FFFFFF",
                                 font=self.font(max(12, int(size * 0.36)), "bold"))
        label.place(relx=0.5, rely=0.5, anchor="center")
        return holder

